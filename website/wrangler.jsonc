{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyrel-waitlist",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "flyrel-waitlist",
      "database_id": "51d4c5cd-2c68-4198-8612-e5dd0f6ef861",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "WAITLIST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
