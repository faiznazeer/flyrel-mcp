{
  "name": "flyrel-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "node --check public/app.js && node --check public/globe.js && node --check public/console.js && node --check src/worker.js && wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply WAITLIST_DB --local",
    "db:remote": "wrangler d1 migrations apply WAITLIST_DB --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "wrangler": "4.156.0"
  }
}
