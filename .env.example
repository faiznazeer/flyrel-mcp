# Credentials are optional. Without them, only the synthetic paper sandbox is connected.
# Never commit your .env. It is loaded from the current working directory.
BROKERBRIDGE_STATE_DIR=.state
BROKERBRIDGE_KITE_API_KEY=
BROKERBRIDGE_KITE_ACCESS_TOKEN=
BROKERBRIDGE_ALPACA_API_KEY=
BROKERBRIDGE_ALPACA_SECRET_KEY=
# Only affects read-only Alpaca account queries; no remote order execution is implemented.
BROKERBRIDGE_ALPACA_PAPER=true
BROKERBRIDGE_ALPACA_FEED=iex
