# Credentials are optional. Without them, only the synthetic paper sandbox is connected.
# Never commit your .env. It is loaded from the current working directory.
FLYREL_STATE_DIR=.state
FLYREL_KITE_API_KEY=
FLYREL_KITE_ACCESS_TOKEN=
FLYREL_ALPACA_API_KEY=
FLYREL_ALPACA_SECRET_KEY=
# Only affects read-only Alpaca account queries; no remote order execution is implemented.
FLYREL_ALPACA_PAPER=true
FLYREL_ALPACA_FEED=iex
# Optional additional credential sets, encoded as a JSON array in your private .env.
# Connection names select reads; they never replace broker-returned account IDs.
# See docs/multi-account.md. Empty means no additional connections.
FLYREL_BROKER_CONNECTIONS=[]
# Optional local instrument catalog. Unregistered symbols remain explicitly unidentified.
# FLYREL_INSTRUMENT_REGISTRY_FILE=.state/instruments.json
